import { LineEdit, ScrollView, ListView } from "std-widgets.slint";
import {
    Button,
    ButtonSize,
    ButtonVariant,
} from "slintcn/components/button.slint";
import { Card, CardPadding, CardVariant } from "slintcn/components/card.slint";
import { Switch } from "slintcn/components/switch.slint";
import { Select, SelectItem } from "slintcn/components/select.slint";
import {
    Text as Typography,
    TextVariant,
    TextTone,
} from "slintcn/components/text.slint";
import {
    Separator,
    SeparatorOrientation,
} from "slintcn/components/separator.slint";
import { Collapsible } from "slintcn/components/collapsible.slint";
import { Badge, BadgeVariant } from "slintcn/components/badge.slint";
import { Icon } from "slintcn/components/icon.slint";
import { LucidePaths } from "slintcn/components/lucide-paths.slint";
import { AspectRatio } from "slintcn/components/aspect-ratio.slint";
import { TooltipContainer } from "slintcn/components/tooltip.slint";
import { AlertDialog } from "slintcn/components/alert-dialog.slint";
import { IntSlider } from "slintcn/components/int-slider.slint";
import { Progress } from "slintcn/components/progress.slint";
import { Tokens } from "slintcn/theme/tokens.slint";

import "./fonts/GoogleSans.ttf";

export struct LogEntry {
    timestamp: string,
    level: string,
    message: string,
}

export struct VideoEntry {
    title: string,
    link: string,
    visibility: string,
    thumbnail: image,
}

component SettingsEntry inherits Rectangle {
    in property <string> description-text;
    in property <string> title-text;

    height: 60px;

    HorizontalLayout {
        padding: 8px;
        spacing: 20px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Typography {
                text: title-text;
                font-size: 15px;
                font-weight: 600;
            }

            Typography {
                text: description-text;
                font-size: 13px;
                tone: TextTone.muted;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

export component AppWindow inherits Window {
    title: "Clip Syncer";
    icon: @image-url("../assets/icon.png");
    preferred-width: 650px;
    min-width: 550px;
    preferred-height: 400px;
    min-height: 280px;
    background: #1a1a1a;

    default-font-family: "Google Sans";

    in property <[LogEntry]> logs: [];
    in property <[VideoEntry]> videos: [];
    callback open_save_dialog();
    in-out property <string> selected_path: "Kein Pfad ausgewählt";
    in property <string> status_text: "Wartet auf Videos...";
    callback delete_original_changed(bool);
    in-out property <bool> delete_original: false;
    callback notify_changed(bool);
    in-out property <bool> notify: false;
    in-out property <int> visibility_selection_index;
    callback privacy_change(int);
    in-out property <int> encoder_selection_index;
    callback encoder_change(int);
    callback upload_now();
    callback link_clicked(string);
    in property <bool> logged_in: false;
    in property <bool> needs_client_secret: false;
    callback select_client_secret();
    in-out property <string> login_url: "";
    in-out property <int> active_account_index: 0;
    callback active_account_change(int);
    in-out property <int> max_uploads_value: 6;
    in-out property <int> max_uploads_limit: 6;
    callback max_uploads_changed(int);
    in-out property <float> upload_progress: 0.0;
    in-out property <bool> is_uploading: false;
    in-out property <string> next_check_text: "";

    Main := ScrollView {
        VerticalLayout {
            padding: 32px;
            padding-bottom: 20px;
            spacing: 20px;
            width: min(root.width - 64px, 800px);
            alignment: center;

            VerticalLayout {
                spacing: 5px;
                Typography {
                    text: "Clip Syncer";
                    font-size: 40px;
                    font-weight: 700;
                    color: #ffffff;
                    horizontal-alignment: center;
                }

                Typography {
                    text: "Synchronisiert Clips aus dem Ordner und lädt sie hoch";
                    variant: TextVariant.body-lg;
                    horizontal-alignment: center;
                    tone: TextTone.muted;
                }
            }

            Separator { }

            if (root.next-check-text != "" || root.is-uploading): Card {
                variant: CardVariant.raised;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    if (root.next-check-text != ""): HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Icon {
                            commands: LucidePaths.clock;
                            size: 16px;
                            tint: Tokens.color-foreground;
                        }

                        Typography {
                            text: root.next-check-text;
                            variant: TextVariant.body;
                            tone: TextTone.muted;
                        }
                    }

                    if (root.is-uploading): VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: space-between;
                            Typography {
                                text: "Upload-Fortschritt...";
                                variant: TextVariant.body-sm;
                                tone: TextTone.muted;
                            }

                            Typography {
                                text: round(root.upload-progress) + "%";
                                variant: TextVariant.body-sm;
                                font-weight: 600;
                                color: Tokens.color-primary;
                            }
                        }

                        Progress {
                            value: root.upload-progress;
                        }
                    }
                }
            }

            Card {
                variant: CardVariant.raised;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Collapsible {
                        title: "Hochgeladene Videos";
                        clip: true;

                        ListView {
                            min-height: max(150px, Main.height - 400px);
                            max-height: 350px;

                            for entry in root.videos: VerticalLayout {
                                padding-right: 20px;
                                padding-bottom: 5px;
                                Card {
                                    HorizontalLayout {
                                        spacing: 8px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        padding-left: 8px;
                                        padding-right: 8px;

                                        VerticalLayout {
                                            alignment: center;
                                            HorizontalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    border-radius: 12px;
                                                    height: 54px;
                                                    width: 96px;
                                                    clip: true;
                                                    Image {
                                                        source: entry.thumbnail;
                                                        width: 100%;
                                                        image-fit: contain;
                                                    }
                                                }
                                            }
                                        }

                                        Separator {
                                            orientation: vertical;
                                        }

                                        VerticalLayout {
                                            alignment: space-between;
                                            HorizontalLayout {
                                                spacing: 8px;

                                                TooltipContainer {
                                                    horizontal-stretch: 1;
                                                    text: entry.title;
                                                    side: top;

                                                    Text {
                                                        text: entry.title;
                                                        font-size: 24px;
                                                        overflow: elide;
                                                        vertical-alignment: bottom;
                                                        horizontal-stretch: 1;
                                                    }
                                                }

                                                VerticalLayout {
                                                    alignment: center;
                                                    horizontal-stretch: 0;

                                                    AspectRatio {
                                                        ratio: 1;
                                                        Card {
                                                            VerticalLayout {
                                                                padding: 6px;
                                                                Icon {
                                                                    commands: entry.visibility == "public" ? LucidePaths.eye :
                                                                        entry.visibility == "unlisted" ? LucidePaths.eye-off : LucidePaths.eye-closed;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            TouchArea {
                                                mouse-cursor: pointer;
                                                horizontal-stretch: 1;
                                                height: txt.preferred-height;

                                                clicked => { link_clicked(entry.link) }
                                                txt := Text {
                                                    text: entry.link;
                                                    horizontal-stretch: 1;
                                                    width: 100%;
                                                    overflow: elide;
                                                    wrap: no-wrap;
                                                    font-family: "monospace";
                                                    font-size: 13px;
                                                    color: parent.has-hover ? #3b82f6 : #d1d5db;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Separator { }

                    Collapsible {
                        title: "Einstellungen";
                        clip: true;

                        SettingsEntry {
                            title-text: "Jetzt hochladen:";
                            description-text: "Warnung: Upload Limit kann überschritten werden";

                            Button {
                                clicked => {
                                    upload_now();
                                }
                                text: "Hochladen";
                                variant: ButtonVariant.destructive;
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: "Pfad:";
                            description-text <=> selected_path;

                            Button {
                                size: ButtonSize.sm;
                                text: "Auswählen...";
                                clicked => { root.open_save_dialog(); }
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: "FFmpeg:";
                            description-text: "Hardware Beschleunigung von FFmpeg";

                            Select {
                                items: [
                                    { label: "Automatisch", value: "auto" },
                                    { label: "CPU", value: "cpu" },
                                    { label: "Nvidia", value: "nvidia" },
                                    { label: "AMD", value: "amd" },
                                    { label: "Intel (GPU)", value: "intel" },
                                ];
                                selected-index <=> encoder_selection_index;
                                changed(i) => { encoder_change(i) }
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: "Sichtbarkeit:";
                            description-text: "Sichtbarkeit des Clips auf YouTube";

                            Select {
                                items: [
                                    { label: "Öffentlich", value: "public" },
                                    { label: "Nicht Gelistet", value: "unlisted" },
                                    { label: "Privat", value: "private" }
                                ];
                                selected-index <=> visibility_selection_index;
                                changed(i) => { privacy_change(i) }
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: "Aktiver Account:";
                            description-text: "Aktuell genutzter Google-Account";

                            Select {
                                items: [
                                    { label: "Hauptaccount", value: "0" },
                                    { label: "Zweitaccount", value: "1" },
                                    { label: "Automatisch", value: "2" }
                                ];
                                selected-index <=> active_account_index;
                                changed(i) => { active_account_change(i) }
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: "Max. Uploads/Tag: " + max_uploads_value;
                            description-text: "Tägliches Limit (1 bis " + max_uploads_limit + ")";

                            IntSlider {
                                minimum: 1;
                                maximum: max_uploads_limit;
                                value <=> max_uploads_value;
                                changed(v) => { max_uploads_changed(v); }
                                width: 120px;
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: "Benachrichtigungen:";
                            description-text: "Willst du über den erfolgreichen Upload benachrichtigt werden?";

                            Switch {
                                checked <=> notify;
                                toggled => {
                                    root.notify_changed(root.notify);
                                }
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: "Löschung:";
                            description-text: "Lokale Originale löschen nach dem Upload?";

                            Switch {
                                checked <=> delete_original;
                                toggled => {
                                    root.delete_original_changed(root.delete_original);
                                }
                            }
                        }
                    }

                    Separator { }

                    Collapsible {
                        title: "Log Viewer";
                        clip: true;

                        ListView {
                            min-height: max(150px, Main.height - 400px);
                            max-height: 350px;

                            for entry in root.logs: VerticalLayout {
                                padding-right: 20px;
                                padding-bottom: 5px;

                                Card {
                                    HorizontalLayout {
                                        spacing: 12px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        padding-left: 8px;
                                        padding-right: 8px;

                                        Text {
                                            text: entry.timestamp;
                                            color: #888888;
                                            width: 65px;
                                            vertical-alignment: center;
                                            font-family: "monospace";
                                            font-size: 12px;
                                        }

                                        Separator {
                                            orientation: vertical;
                                        }

                                        VerticalLayout {
                                            width: 40px;
                                            alignment: start;

                                            Badge {
                                                text: entry.level;
                                                variant: entry.level == "ERROR" ? BadgeVariant.destructive :
                                                    entry.level == "TRACE" ? BadgeVariant.outline :
                                                    entry.level == "INFO" ? BadgeVariant.default : BadgeVariant.secondary;
                                            }
                                        }

                                        Separator {
                                            orientation: vertical;
                                        }

                                        Text {
                                            text: entry.message;
                                            horizontal-stretch: 1;
                                            wrap: word-wrap;
                                            font-family: "monospace";
                                            color: #d1d5db;
                                            vertical-alignment: center;
                                            font-size: 13px;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    dlg_secret := AlertDialog {
        width: parent.width;
        height: parent.height;
        open: needs_client_secret;
        title: "Google API Setup";
        description: "Um auf YouTube hochzuladen, wird eine 'client_secret.json' benötigt:\n\n1. Gehe zu console.cloud.google.com und erstelle ein Projekt.\n2. Aktiviere dort die 'YouTube Data API v3'.\n3. Erstelle unter Anmeldedaten eine 'OAuth-Client-ID' (Typ: Desktop-App).\n4. Lade die JSON-Datei herunter und wähle sie hier aus.";
        cancel-label: "Datei auswählen";
        cancelled => {
            select_client_secret();
        }
    }

    if (!logged_in && !needs_client_secret): Rectangle {
        width: parent.width;
        height: parent.height;
        x: 0;
        y: 0;

        Card {
            height: 60%;
            width: 460px;
            variant: CardVariant.raised;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Typography {
                    text: "Google Anmeldung";
                    font-size: 20px;
                    font-weight: 700;
                    color: #ffffff;
                }

                Typography {
                    text: "Um Videos auf YouTube hochzuladen, ist eine Anmeldung bei Google erforderlich. Es öffnet sich gleich ein Browser-Fenster.";
                    variant: TextVariant.body;
                    tone: TextTone.muted;
                    wrap: word-wrap;
                }

                if (login_url != ""): VerticalLayout {
                    spacing: 12px;

                    Typography {
                        text: "Falls sich das Fenster nicht automatisch geöffnet hat, kannst du den Link kopieren oder manuell öffnen:";
                        variant: TextVariant.body-sm;
                        tone: TextTone.muted;
                        wrap: word-wrap;
                    }

                    LineEdit {
                        text: login_url;
                        read-only: true;
                        font-family: "monospace";
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        Button {
                            text: "Im Browser öffnen";
                            variant: ButtonVariant.default;
                            clicked => {
                                link_clicked(login_url);
                            }
                        }
                    }
                }

                if (login_url == ""): HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    Typography {
                        text: "Generiere Anmelde-Link...";
                        variant: TextVariant.body;
                        tone: TextTone.muted;
                    }
                }
            }
        }
    }
}
