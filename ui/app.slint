import { LineEdit, ScrollView } from "std-widgets.slint";
import { Button, ButtonSize } from "slintcn/components/button.slint";
import { Card, CardPadding, CardVariant } from "slintcn/components/card.slint";
import {
    Text as Typography,
    TextVariant,
    TextTone,
} from "slintcn/components/text.slint";
import {
    Separator,
    SeparatorOrientation,
} from "slintcn/components/separator.slint";


component SettingsEntry inherits VerticalLayout {
    in property <string> description-text;
    in property <string> title-text;
    callback open_save_dialog();

    height: 70px;
    padding: 10px;
    alignment: space-between;

    Typography {
        text: title-text;
        font-size: 22px;
    }

    HorizontalLayout {
        spacing: 30px;
        VerticalLayout {
            alignment: center;
            Typography {
                text: description-text;
                font-size: 18px;
                variant: TextVariant.body-lg;
                tone: TextTone.muted;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: end;
            @children
        }
    }
}

export component AppWindow inherits Window {
    preferred-width: 500px;
    min-width: 400px;
    preferred-height: 380px;
    min-height: 280px;
    title: "Clip Syncer";
    background: #1a1a1a;

    callback open_save_dialog();
    in-out property <string> selected_path: "Kein Pfad ausgewählt";
    in property <string> status_text: "Wartet auf Videos...";

    ScrollView {
        VerticalLayout {
            padding: 32px;
            spacing: 20px;
            width: min(root.width - 64px, 600px);
            alignment: center;

            VerticalLayout {
                spacing: 5px;
                Typography {
                    text: "Clip Syncer";
                    font-size: 48px;
                    font-weight: 700;
                    color: #ffffff;
                    horizontal-alignment: center;
                }

                Typography {
                    text: "Clip Syncer";
                    variant: TextVariant.body-lg;
                    horizontal-alignment: center;
                    tone: TextTone.muted;
                }
            }

            Separator { }

            Card {
                variant: CardVariant.raised;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Typography {
                        text: "Settings";
                        variant: TextVariant.headline;
                    }

                    Separator { }

                    SettingsEntry {
                        title-text: "Pfad:";
                        description-text <=> root.selected_path;
                        open_save_dialog => { root.open_save_dialog(); }

                        Button {
                            size: ButtonSize.xs;
                            text: "Auswählen...";
                            clicked => { root.open_save_dialog(); }
                        }
                    }
                }
            }
        }
    }
}
