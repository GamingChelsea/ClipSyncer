import { LineEdit, ScrollView, ListView } from "std-widgets.slint";
import {
    Button,
    ButtonSize,
    ButtonVariant,
} from "slintcn/components/button.slint";
import { Card, CardPadding, CardVariant } from "slintcn/components/card.slint";
import { Switch } from "slintcn/components/switch.slint";
import { Select, SelectItem } from "slintcn/components/select.slint";
import {
    Text as Typography,
    TextVariant,
    TextTone,
} from "slintcn/components/text.slint";
import {
    Separator,
    SeparatorOrientation,
} from "slintcn/components/separator.slint";
import { Collapsible } from "slintcn/components/collapsible.slint";
import { Badge, BadgeVariant } from "slintcn/components/badge.slint";
import { Icon } from "slintcn/components/icon.slint";
import { LucidePaths } from "slintcn/components/lucide-paths.slint";
import { AspectRatio } from "slintcn/components/aspect-ratio.slint";
import { TooltipContainer } from "slintcn/components/tooltip.slint";
import { AlertDialog } from "slintcn/components/alert-dialog.slint";
import { IntSlider } from "slintcn/components/int-slider.slint";
import { Progress } from "slintcn/components/progress.slint";
import { Tokens } from "slintcn/theme/tokens.slint";

import "./fonts/GoogleSans.ttf";

export struct LogEntry {
    timestamp: string,
    level: string,
    message: string,
}

export struct VideoEntry {
    title: string,
    link: string,
    visibility: string,
    thumbnail: image,
}

export struct I18nStrings {
    uploaded_videos_title: string,
    settings_title: string,
    now_upload_title: string,
    now_upload_desc: string,
    btn_upload: string,
    import_config_title: string,
    import_config_desc: string,
    btn_import: string,
    path_title: string,
    btn_select: string,
    ffmpeg_title: string,
    ffmpeg_desc: string,
    visibility_title: string,
    visibility_desc: string,
    active_account_title: string,
    active_account_desc: string,
    max_uploads_title: string,
    max_uploads_desc: string,
    notifications_title: string,
    notifications_desc: string,
    autostart_title: string,
    autostart_desc: string,
    deletion_title: string,
    deletion_desc: string,
    log_viewer_title: string,
    google_login_title: string,
    google_login_desc: string,
    google_login_manual: string,
    btn_open_browser: string,
    generating_login_link: string,
    ffmpeg_setup_title: string,
    status_waiting: string,
    google_api_setup_title: string,
    google_api_setup_desc: string,
    btn_select_file: string,
    language_title: string,
    language_desc: string,
    vis_public: string,
    vis_unlisted: string,
    vis_private: string,
    encoder_auto: string,
    account_main: string,
    account_alt: string,
    account_auto: string,
    upload_progress_title: string,
    status_scanning: string,
    status_processing: string,
    status_uploading: string,
    status_no_clips: string,
    status_limit_reached: string,
    status_completed: string,
    status_cancelled: string,
    btn_cancel: string,
}

component SettingsEntry inherits Rectangle {
    in property <string> description-text;
    in property <string> title-text;

    height: 60px;

    HorizontalLayout {
        padding: 8px;
        spacing: 20px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Typography {
                text: title-text;
                font-size: 15px;
                font-weight: 600;
            }

            Typography {
                text: description-text;
                font-size: 13px;
                tone: TextTone.muted;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

export component AppWindow inherits Window {
    title: "Clip Syncer";
    icon: @image-url("../assets/icon.png");
    preferred-width: 650px;
    min-width: 550px;
    preferred-height: 400px;
    min-height: 280px;
    background: #1a1a1a;

    default-font-family: "Google Sans";

    in property <I18nStrings> i18n;
    in property <[LogEntry]> logs: [];
    in property <[VideoEntry]> videos: [];
    callback open_save_dialog();
    in-out property <string> selected_path: "Kein Pfad ausgewählt";
    in property <string> status_text: "Wartet auf Videos...";
    callback delete_original_changed(bool);
    in-out property <bool> delete_original: false;
    callback notify_changed(bool);
    in-out property <bool> notify: false;
    in-out property <int> visibility_selection_index;
    callback privacy_change(int);
    in-out property <int> encoder_selection_index;
    callback encoder_change(int);
    callback upload_now();
    callback cancel_upload();
    callback link_clicked(string);
    in property <bool> logged_in: false;
    in property <bool> needs_client_secret: false;
    callback select_client_secret();
    in-out property <string> login_url: "";
    in-out property <int> active_account_index: 0;
    callback active_account_change(int);
    in-out property <int> max_uploads_value: 6;
    in-out property <int> max_uploads_limit: 6;
    callback max_uploads_changed(int);
    in-out property <float> upload_progress: 0.0;
    in-out property <bool> is_uploading: false;
    in-out property <bool> is_processing: false;
    in-out property <string> next_check_text: "";
    callback import_config();
    in-out property <bool> autostart: false;
    callback autostart_changed(bool);
    in-out property <int> language_selection_index: 0;
    callback language_change(int);

    Main := ScrollView {
        VerticalLayout {
            padding: 32px;
            padding-bottom: 20px;
            spacing: 20px;
            width: min(root.width - 64px, 800px);
            alignment: center;

            VerticalLayout {
                spacing: 5px;
                Typography {
                    text: "Clip Syncer";
                    font-size: 40px;
                    font-weight: 700;
                    color: #ffffff;
                    horizontal-alignment: center;
                }

                Typography {
                    text: root.status-text;
                    variant: TextVariant.body-lg;
                    horizontal-alignment: center;
                    tone: TextTone.muted;
                }
            }

            Separator { }

            if (root.next-check-text != "" || root.is-uploading): Card {
                variant: CardVariant.raised;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    if (root.next-check-text != ""): HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Icon {
                            commands: LucidePaths.clock;
                            size: 16px;
                            tint: Tokens.color-foreground;
                        }

                        Typography {
                            text: root.next-check-text;
                            variant: TextVariant.body;
                            tone: TextTone.muted;
                        }
                    }

                    if (root.is-uploading): VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: space-between;
                            Typography {
                                text: root.i18n.upload_progress_title;
                                variant: TextVariant.body-sm;
                                tone: TextTone.muted;
                            }

                            Typography {
                                text: round(root.upload-progress) + "%";
                                variant: TextVariant.body-sm;
                                font-weight: 600;
                                color: Tokens.color-primary;
                            }
                        }

                        Progress {
                            value: root.upload-progress;
                        }
                    }
                }
            }

            Card {
                variant: CardVariant.raised;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Collapsible {
                        title: root.i18n.uploaded_videos_title;
                        clip: true;

                        ListView {
                            min-height: max(150px, Main.height - 400px);
                            max-height: 350px;

                            for entry in root.videos: VerticalLayout {
                                padding-right: 20px;
                                padding-bottom: 5px;
                                Card {
                                    HorizontalLayout {
                                        spacing: 8px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        padding-left: 8px;
                                        padding-right: 8px;

                                        VerticalLayout {
                                            alignment: center;
                                            HorizontalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    border-radius: 12px;
                                                    height: 54px;
                                                    width: 96px;
                                                    clip: true;
                                                    Image {
                                                        source: entry.thumbnail;
                                                        width: 100%;
                                                        image-fit: contain;
                                                    }
                                                }
                                            }
                                        }

                                        Separator {
                                            orientation: vertical;
                                        }

                                        VerticalLayout {
                                            alignment: space-between;
                                            HorizontalLayout {
                                                spacing: 8px;

                                                TooltipContainer {
                                                    horizontal-stretch: 1;
                                                    text: entry.title;
                                                    side: top;

                                                    Text {
                                                        text: entry.title;
                                                        font-size: 24px;
                                                        overflow: elide;
                                                        vertical-alignment: bottom;
                                                        horizontal-stretch: 1;
                                                    }
                                                }

                                                VerticalLayout {
                                                    alignment: center;
                                                    horizontal-stretch: 0;

                                                    AspectRatio {
                                                        ratio: 1;
                                                        Card {
                                                            VerticalLayout {
                                                                padding: 6px;
                                                                Icon {
                                                                    commands: entry.visibility == "public" ? LucidePaths.eye :
                                                                        entry.visibility == "unlisted" ? LucidePaths.eye-off : LucidePaths.eye-closed;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            TouchArea {
                                                mouse-cursor: pointer;
                                                horizontal-stretch: 1;
                                                height: txt.preferred-height;

                                                clicked => { link_clicked(entry.link) }
                                                txt := Text {
                                                    text: entry.link;
                                                    horizontal-stretch: 1;
                                                    width: 100%;
                                                    overflow: elide;
                                                    wrap: no-wrap;
                                                    font-family: "monospace";
                                                    font-size: 13px;
                                                    color: parent.has-hover ? #3b82f6 : #d1d5db;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Separator { }

                    Collapsible {
                        title: root.i18n.settings_title;
                        clip: true;

                        SettingsEntry {
                            title-text: root.i18n.language_title;
                            description-text: root.i18n.language_desc;

                            Select {
                                items: [
                                    { label: "Deutsch", value: "de" },
                                    { label: "English", value: "en" }
                                ];
                                selected-index <=> language_selection_index;
                                changed(i) => { language_change(i) }
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: root.i18n.now_upload_title;
                            description-text: root.i18n.now_upload_desc;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;

                                if (root.is-processing || root.is-uploading): Button {
                                    clicked => {
                                        cancel_upload();
                                    }
                                    text: root.i18n.btn_cancel;
                                    variant: ButtonVariant.outline;
                                }

                                Button {
                                    disabled: root.is-uploading || root.is-processing;
                                    clicked => {
                                        root.is-processing = true;
                                        upload_now();
                                    }
                                    text: root.is-processing || root.is-uploading ? (root.is-uploading ? root.i18n.status_uploading : root.i18n.status_processing) : root.i18n.btn_upload;
                                    variant: ButtonVariant.destructive;
                                }
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: root.i18n.import_config_title;
                            description-text: root.i18n.import_config_desc;

                            Button {
                                clicked => {
                                    root.import_config();
                                }
                                text: root.i18n.btn_import;
                                variant: ButtonVariant.default;
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: root.i18n.path_title;
                            description-text <=> selected_path;

                            Button {
                                size: ButtonSize.sm;
                                text: root.i18n.btn_select;
                                clicked => { root.open_save_dialog(); }
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: root.i18n.ffmpeg_title;
                            description-text: root.i18n.ffmpeg_desc;

                            Select {
                                items: [
                                    { label: root.i18n.encoder_auto, value: "auto" },
                                    { label: "CPU", value: "cpu" },
                                    { label: "Nvidia", value: "nvidia" },
                                    { label: "AMD", value: "amd" },
                                    { label: "Intel (GPU)", value: "intel" },
                                ];
                                selected-index <=> encoder_selection_index;
                                changed(i) => { encoder_change(i) }
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: root.i18n.visibility_title;
                            description-text: root.i18n.visibility_desc;

                            Select {
                                items: [
                                    { label: root.i18n.vis_public, value: "public" },
                                    { label: root.i18n.vis_unlisted, value: "unlisted" },
                                    { label: root.i18n.vis_private, value: "private" }
                                ];
                                selected-index <=> visibility_selection_index;
                                changed(i) => { privacy_change(i) }
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: root.i18n.active_account_title;
                            description-text: root.i18n.active_account_desc;

                            Select {
                                items: [
                                    { label: root.i18n.account_main, value: "0" },
                                    { label: root.i18n.account_alt, value: "1" },
                                    { label: root.i18n.account_auto, value: "2" }
                                ];
                                selected-index <=> active_account_index;
                                changed(i) => { active_account_change(i) }
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: root.i18n.max_uploads_title + " " + max_uploads_value;
                            description-text: root.i18n.max_uploads_desc + " (1 bis " + max_uploads_limit + ")";

                            IntSlider {
                                minimum: 1;
                                maximum: max_uploads_limit;
                                value <=> max_uploads_value;
                                changed(v) => { max_uploads_changed(v); }
                                width: 120px;
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: root.i18n.notifications_title;
                            description-text: root.i18n.notifications_desc;

                            Switch {
                                checked <=> notify;
                                toggled => {
                                    root.notify_changed(root.notify);
                                }
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: root.i18n.autostart_title;
                            description-text: root.i18n.autostart_desc;

                            Switch {
                                checked <=> autostart;
                                toggled => {
                                    root.autostart_changed(root.autostart);
                                }
                            }
                        }

                        Separator { }

                        SettingsEntry {
                            title-text: root.i18n.deletion_title;
                            description-text: root.i18n.deletion_desc;

                            Switch {
                                checked <=> delete_original;
                                toggled => {
                                    root.delete_original_changed(root.delete_original);
                                }
                            }
                        }
                    }

                    Separator { }

                    Collapsible {
                        title: root.i18n.log_viewer_title;
                        clip: true;

                        ListView {
                            min-height: max(150px, Main.height - 400px);
                            max-height: 350px;

                            for entry in root.logs: VerticalLayout {
                                padding-right: 20px;
                                padding-bottom: 5px;

                                Card {
                                    HorizontalLayout {
                                        spacing: 12px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        padding-left: 8px;
                                        padding-right: 8px;

                                        Text {
                                            text: entry.timestamp;
                                            color: #888888;
                                            width: 65px;
                                            vertical-alignment: center;
                                            font-family: "monospace";
                                            font-size: 12px;
                                        }

                                        Separator {
                                            orientation: vertical;
                                        }

                                        VerticalLayout {
                                            width: 40px;
                                            alignment: start;

                                            Badge {
                                                text: entry.level;
                                                variant: entry.level == "ERROR" ? BadgeVariant.destructive :
                                                    entry.level == "TRACE" ? BadgeVariant.outline :
                                                    entry.level == "INFO" ? BadgeVariant.default : BadgeVariant.secondary;
                                            }
                                        }

                                        Separator {
                                            orientation: vertical;
                                        }

                                        Text {
                                            text: entry.message;
                                            horizontal-stretch: 1;
                                            wrap: word-wrap;
                                            font-family: "monospace";
                                            color: #d1d5db;
                                            vertical-alignment: center;
                                            font-size: 13px;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    dlg_secret := AlertDialog {
        width: parent.width;
        height: parent.height;
        open: needs_client_secret;
        title: root.i18n.google_api_setup_title;
        description: root.i18n.google_api_setup_desc;
        cancel-label: root.i18n.btn_select_file;
        cancelled => {
            select_client_secret();
        }
    }

    if (!logged_in && !needs_client_secret): Rectangle {
        width: parent.width;
        height: parent.height;
        x: 0;
        y: 0;

        Card {
            height: 60%;
            width: 460px;
            variant: CardVariant.raised;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Typography {
                    text: root.i18n.google_login_title;
                    font-size: 20px;
                    font-weight: 700;
                    color: #ffffff;
                }

                Typography {
                    text: root.i18n.google_login_desc;
                    variant: TextVariant.body;
                    tone: TextTone.muted;
                    wrap: word-wrap;
                }

                if (login_url != ""): VerticalLayout {
                    spacing: 12px;

                    Typography {
                        text: root.i18n.google_login_manual;
                        variant: TextVariant.body-sm;
                        tone: TextTone.muted;
                        wrap: word-wrap;
                    }

                    LineEdit {
                        text: login_url;
                        read-only: true;
                        font-family: "monospace";
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        Button {
                            text: root.i18n.btn_open_browser;
                            variant: ButtonVariant.default;
                            clicked => {
                                link_clicked(login_url);
                            }
                        }
                    }
                }

                if (login_url == ""): HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    Typography {
                        text: root.i18n.generating_login_link;
                        variant: TextVariant.body;
                        tone: TextTone.muted;
                    }
                }
            }
        }
    }
}
